# syntax=docker/dockerfile:1.7

# ---------------------------------------------------------------------------
# API image — works on amd64 (Northflank/Render/Koyeb) and arm64 (Oracle)
# Build: docker build -f Dockerfile.api -t creatorhub-api .
# ---------------------------------------------------------------------------

FROM node:22-bookworm-slim AS base

ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true \
    TURBO_TELEMETRY_DISABLED=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@11.5.3 --activate

WORKDIR /app

# Fetch external packages from the lockfile only, so source changes don't
# invalidate the dependency cache.
FROM base AS deps

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY patches ./patches
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm fetch

FROM deps AS build

COPY . .

RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --no-frozen-lockfile

# Prisma only needs a syntactically valid URL for `generate`.
ARG DATABASE_URL=postgresql://build:build@localhost:5432/build
ENV DATABASE_URL=$DATABASE_URL
ENV NODE_OPTIONS=--max-old-space-size=4096

RUN pnpm db:generate
RUN pnpm turbo run build --filter=@creator-hub/api...

# pnpm deploy writes a self-contained package with production dependencies.
# --legacy is required because this workspace does not use injected deps.
FROM build AS deploy

RUN pnpm --filter @creator-hub/api deploy --prod --legacy /prod/api
RUN mkdir -p /prod/api/packages/database/generated; \
    if [ -d packages/database/generated ]; then \
      cp -r packages/database/generated/. /prod/api/packages/database/generated/ || true; \
    fi; \
    for d in /prod/api/node_modules/.pnpm/@creator-hub+database*/node_modules/@creator-hub/database /prod/api/node_modules/@creator-hub/database; do \
      if [ -d "$d" ] && [ -d packages/database/generated ]; then \
        mkdir -p "$d/generated" && cp -r packages/database/generated/. "$d/generated/" || true; \
      fi; \
    done; \
    find /app -path /prod -prune -o -name "*debian-openssl-3.0.x*.so.node" -print0 2>/dev/null | xargs -0 -r -I{} cp -f "{}" /prod/api/packages/database/generated/ || true

# Never ship local env files or database backups.
RUN find /prod/api -type f \( -name '.env' -o -name '.env.*' \) -delete \
    && find /prod/api -type d \( -name backups -o -name .turbo \) -prune -exec rm -rf {} +

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production \
    PORT=3001

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 1001 nodejs \
    && useradd --system --uid 1001 --gid nodejs --create-home appuser

WORKDIR /app

COPY --from=deploy --chown=appuser:nodejs /prod/api ./

USER appuser

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD node -e "const net=require('net');const s=net.connect(process.env.PORT||3001,'127.0.0.1');s.on('connect',()=>{s.end();process.exit(0)});s.on('error',()=>process.exit(1));setTimeout(()=>process.exit(1),4000)"

CMD ["node", "dist/main.js"]
