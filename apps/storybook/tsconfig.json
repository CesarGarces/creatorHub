{
  "extends": "../../packages/typescript-config/nextjs.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "plugins": [],
    "paths": {
      "@/*": ["../web/src/*"]
    }
  },
  "include": [
    "storybook-env.d.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "stories/**/*.ts",
    "stories/**/*.tsx",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "storybook-static",
    ".storybook/decorators/admin.tsx",
    "stories/admin/**"
  ]
}
