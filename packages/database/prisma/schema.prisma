generator client {
  provider      = "prisma-client"
  output        = "../generated"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SocialResearchSession {
  id        String                  @id @default(cuid())
  userId    String
  toolId    String
  title     String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  messages  SocialResearchMessage[]
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, toolId])
  @@index([userId])
}

model SocialResearchMessage {
  id          String                @id @default(cuid())
  sessionId   String
  role        String
  content     String
  resultData  Json?
  provider    String?
  creditsUsed Int                   @default(0)
  cacheHit    Boolean               @default(false)
  createdAt   DateTime              @default(now())
  session     SocialResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

model TrendCache {
  id         String   @id @default(cuid())
  queryHash  String
  provider   String
  resultData Json
  expiresAt  DateTime
  hitCount   Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([queryHash, provider])
  @@index([queryHash, provider])
  @@index([expiresAt])
}

model User {
  id                   String                  @id @default(cuid())
  email                String                  @unique
  name                 String?
  passwordHash         String?
  avatarUrl            String?
  role                 UserRole                @default(USER)
  isActive             Boolean                 @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  plan                 UserPlan                @default(FREE)
  currentCredits       Int                     @default(100)
  purchasedCredits     Int                     @default(0)
  emailVerified        DateTime?
  verificationCode     String?
  verificationExpires  DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  /// Interface language chosen by the user ("en" | "es" | "pt"). Null = not chosen yet.
  preferredLanguage    String?
  accounts             Account[]
  apiKeys              ApiKey[]
  assetLikes           AssetLike[]
  chatSessions         ChatSession[]
  chatSettings         ChatSettings?
  creditTxns           CreditTransaction[]
  images               GeneratedImage[]
  marketingEvents      MarketingEvent[]
  creditEmailLogs      CreditEmailLog[]
  notifications        Notification[]
  sessions             Session[]
  socialAccounts       SocialAccount[]
  researchSessions     SocialResearchSession[]
  subscriptions        Subscription[]
  toolAccess           ToolAccess[]
  toolFavorites        ToolFavorite[]
  dashboardLayout      DashboardLayout?
  tweetDrafts          TweetDraft[]
  usageLogs            UsageLog[]
  contentSamples       UserContentSample[]
  styleProfile         UserStyleProfile?
  generatedScripts     GeneratedScript[]
  communityBotConfig   CommunityBotConfig?
  communityChannels    CommunityChannel[]
  contentProjects      ContentProject[]
  contentEvents        ContentEvent[]
  contentCustomTypes   ContentCustomType[]
  contentCustomPlatforms ContentCustomPlatform[]
  contentProductionSteps ContentProductionStep[]
  contentAiPlans         ContentAiPlan[]
  contentKnowledgeChunks ContentKnowledgeChunk[]
  videoAnalyses          VideoAnalysis[]
  voiceConversations     VoiceConversation[]
  voiceUsage             VoiceUsage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  name      String
  key       String    @unique
  lastUsed  DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Mode {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  icon        String?
  color       String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tools       ToolMode[]
  providers   ProviderMode[]
}

model ToolMode {
  id        String   @id @default(cuid())
  toolId    String
  modeId    String
  createdAt DateTime @default(now())
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  mode      Mode     @relation(fields: [modeId], references: [id], onDelete: Cascade)

  @@unique([toolId, modeId])
  @@index([toolId])
  @@index([modeId])
}

model ProviderMode {
  id         String   @id @default(cuid())
  providerId String
  modeId     String
  createdAt  DateTime @default(now())
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  mode       Mode     @relation(fields: [modeId], references: [id], onDelete: Cascade)

  @@unique([providerId, modeId])
  @@index([providerId])
  @@index([modeId])
}

model Tool {
  id              String              @id
  name            String
  description     String
  version         String              @default("1.0.0")
  icon            String?
  category        String
  creditsPerUse   Int                 @default(10)
  status          String              @default("active")
  configSchema    Json?
  manifestVersion String              @default("1.0")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  creditTxns      CreditTransaction[]
  images          GeneratedImage[]
  toolAccess      ToolAccess[]
  toolConfigs     ToolConfig?
  usageLogs       UsageLog[]
  modes           ToolMode[]
}

model ToolConfig {
  id                String   @id @default(cuid())
  toolId            String   @unique
  enabled           Boolean  @default(true)
  creditsPerUse     Int
  maxUsesPerDay     Int?
  allowedRoles      String[] @default([])
  providerOverrides Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tool              Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
}

model ToolAccess {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
}

model ToolFavorite {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  createdAt DateTime @default(now())
  sortOrder Int      @default(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@index([toolId])
  @@index([userId, sortOrder])
}

/// Dashboard widgets of a user: order + visibility (ARCHITECTURE.md §2f).
/// No row = the default layout (DEFAULT_DASHBOARD_WIDGETS).
model DashboardLayout {
  id        String   @id @default(cuid())
  userId    String   @unique
  /// Ordered [{ id, visible }], read through normalizeDashboardWidgets().
  widgets   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id          String                @id @default(cuid())
  userId      String
  amount      Int
  type        CreditTransactionType
  description String
  toolId      String?
  provider    String?
  // Idempotency key for credit grants (e.g. "signup:{userId}", payment gateway IDs).
  // Unique at DB level so concurrent duplicate grants fail instead of double-crediting.
  // PostgreSQL allows multiple NULLs in unique columns, so non-referenced rows are unaffected.
  referenceId String?               @unique
  balance     Int
  createdAt   DateTime              @default(now())
  tool        Tool?                 @relation(fields: [toolId], references: [id])
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
}

model CreditPlan {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String?
  usdAmount    Float
  creditsGiven Int
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  creditsThisPeriod    Int                @default(0)
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id])
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id              String         @id @default(cuid())
  name            String
  description     String?
  price           Int
  creditsPerMonth Int
  features        String[]
  tools           String[]
  stripePriceId   String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  subscriptions   Subscription[]
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  credits   Int
  duration  Int?
  success   Boolean  @default(true)
  error     String?
  metadata  Json?
  createdAt DateTime @default(now())
  tool      Tool     @relation(fields: [toolId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model AIProviderConfig {
  id        String   @id @default(cuid())
  name      String   @unique
  isEnabled Boolean  @default(true)
  priority  Int      @default(0)
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Provider {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  model          String
  tier           ProviderTier     @default(FREE)
  costPerCredit  Int              @default(1)
  isActive       Boolean          @default(true)
  supportedTasks String[]         @default(["thumbnail"])
  config         Json?

  // Gateway support (for OpenRouter, SiliconFlow, etc.)
  isGateway      Boolean          @default(false)
  gatewayConfig  Json?            // { baseUrl, headers, etc. }

  // Sync metadata
  lastSyncAt     DateTime?
  syncStatus     String?          // "syncing" | "success" | "error"

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  images         GeneratedImage[]
  modes          ProviderMode[]
}

// ============================================================
// MODEL METADATA - Centralized model registry for AI providers
// ============================================================
model ModelMetadata {
  id                String   @id @default(cuid())
  providerSlug      String   // "openrouter", "siliconflow"
  modelId           String   // "google/gemini-3.1-flash-image"
  displayName       String   // "Gemini 3.1 Flash Image"
  taskType          String   // "image-generation", "chat", "video-generation"
  tier              ProviderTier @default(PRO)

  // Model capabilities
  contextLength     Int?
  maxOutputTokens   Int?
  supportsStreaming Boolean  @default(false)
  supportsVision    Boolean  @default(false)

  // Pricing (from provider API, USD)
  promptPricePer1k      Float?
  completionPricePer1k  Float?
  imagePricePerGen      Float?

  // Rate limits
  requestsPerMinute Int?
  tokensPerMinute   Int?

  // Admin configuration
  isActive          Boolean  @default(false)
  creditCost        Int      @default(10)
  profitMargin      Float    @default(2.0)
  /// Added by an admin ("Add model"); provider sync never updates or deactivates it.
  isCustom          Boolean  @default(false)

  // Metadata
  description       String?
  tags              String[]
  integratedAt      DateTime @default(now()) // When the model was added to the platform
  lastSyncedAt      DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([providerSlug, modelId])
  @@index([taskType, isActive])
  @@index([tier, isActive])
  @@index([providerSlug, isActive])
  @@index([integratedAt])
}

// ============================================================
// PROVIDER USAGE - Cost tracking per model per day
// ============================================================
model ProviderUsage {
  id                String   @id @default(cuid())
  providerSlug      String
  modelId           String
  date              DateTime @db.Date

  // Usage metrics
  totalRequests     Int      @default(0)
  totalTokens       Int      @default(0)
  totalImages       Int      @default(0)

  // Cost tracking
  actualCostUsd     Float    @default(0)   // What we pay to provider
  creditsCharged    Int      @default(0)   // What we charge users

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([providerSlug, modelId, date])
  @@index([date])
  @@index([providerSlug, date])
}

model AIRequestLog {
  id        String   @id @default(cuid())
  userId    String?
  toolId    String?
  provider  String
  model     String
  taskType  String
  prompt    String
  response  Json?
  credits   Int
  latency   Int
  success   Boolean  @default(true)
  error     String?
  createdAt DateTime @default(now())
}

model File {
  id           String           @id @default(cuid())
  userId       String?
  toolId       String?
  originalName String
  mimeType     String
  size         Int
  key          String           @unique
  url          String
  width        Int?
  height       Int?
  duration     Int?
  metadata     Json?
  createdAt    DateTime         @default(now())
  images       GeneratedImage[]
}

model GeneratedImage {
  id              String             @id @default(cuid())
  userId          String
  toolId          String?
  fileId          String?
  prompt          String
  negativePrompt  String?
  provider        String
  model           String
  width           Int
  height          Int
  url             String
  credits         Int
  metadata        Json?
  isPublic        Boolean            @default(false)
  createdAt       DateTime           @default(now())
  storageProvider String             @default("r2")
  isProModel      Boolean            @default(false)
  providerId      String?
  type            GeneratedAssetType @default(IMAGE)
  likeCount       Int                @default(0)
  viewCount       Int                @default(0)
  likes           AssetLike[]
  file            File?              @relation(fields: [fileId], references: [id])
  providerRef     Provider?          @relation(fields: [providerId], references: [id])
  tool            Tool?              @relation(fields: [toolId], references: [id])
  user            User               @relation(fields: [userId], references: [id])
}

model AssetLike {
  id          String         @id @default(cuid())
  assetId     String
  fingerprint String
  userId      String?
  createdAt   DateTime       @default(now())
  asset       GeneratedImage @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id])

  @@unique([assetId, fingerprint])
  @@index([assetId])
  @@index([fingerprint])
  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@index([createdAt])
}

model MarketingEvent {
  id        String             @id @default(cuid())
  userId    String
  type      MarketingEventType
  credits   Int
  metadata  Json?
  createdAt DateTime           @default(now())
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Email sent to a user when they enter a credit state (MarketingEventType).
/// Managed from the admin panel (Credit Emails). One trigger per state.
model CreditEmailTrigger {
  id        String             @id @default(cuid())
  state     MarketingEventType @unique
  subject   String
  heading   String
  body      String
  ctaLabel  String?
  ctaUrl    String?
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  logs      CreditEmailLog[]
}

/// Delivery log for credit state emails (also used for idempotency).
model CreditEmailLog {
  id        String              @id @default(cuid())
  userId    String
  triggerId String?
  state     MarketingEventType
  credits   Int
  email     String
  subject   String
  status    CreditEmailStatus   @default(PENDING)
  error     String?
  // Deterministic idempotency key "{userId}:{state}:{creditCycle}": at most one
  // email per state per credit cycle, enforced at DB level (see SEC-06).
  // NULL for admin test emails.
  dedupeKey String?             @unique
  isTest    Boolean             @default(false)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  trigger   CreditEmailTrigger? @relation(fields: [triggerId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}

model ChatSession {
  id          String        @id @default(cuid())
  userId      String
  title       String?
  model       String        @default("zai-org/GLM-5.2")
  temperature Float         @default(0.7)
  maxTokens   Int           @default(8000)
  reasoning   Float         @default(0.7)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatMessage {
  id         String      @id @default(cuid())
  sessionId  String
  role       String
  content    String
  toolCalls  Json?
  tokensUsed Int?
  createdAt  DateTime    @default(now())
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ChatSettings {
  id           String   @id @default(cuid())
  userId       String   @unique
  defaultModel String   @default("zai-org/GLM-5.2")
  temperature  Float    @default(0.7)
  maxTokens    Int      @default(8000)
  reasoning    Float    @default(0.7)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserContentSample {
  id        String              @id @default(cuid())
  userId    String
  content   String
  source    ContentSampleSource @default(MANUAL)
  metadata  Json?
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isActive])
}

model UserStyleProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  tone           String
  vocabKeywords  String[]  @default([])
  sentenceLength String    @default("medium")
  emojiUsage     String    @default("moderate")
  formalityLevel String    @default("casual")
  summary        String?
  sampleCount    Int       @default(0)
  isActive       Boolean   @default(true)
  lastAnalyzedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  language       String    @default("es")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialAccount {
  id               String              @id @default(cuid())
  userId           String
  provider         SocialProvider
  providerUserId   String
  providerUsername String?
  displayName      String?
  avatarUrl        String?
  accessToken      String
  refreshToken     String?
  tokenExpiresAt   DateTime?
  scopes           String[]            @default([])
  status           SocialAccountStatus @default(ACTIVE)
  metadata         Json?
  lastUsedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tweetDrafts      TweetDraft[]

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider, status])
}

model TweetDraft {
  id               String           @id @default(cuid())
  userId           String
  socialAccountId  String?
  content          String
  topic            String?
  researchData     Json?
  styleProfileId   String?
  status           TweetDraftStatus @default(DRAFT)
  publishedTweetId String?
  publishedAt      DateTime?
  metadata         Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  socialAccount    SocialAccount?   @relation(fields: [socialAccountId], references: [id])
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
}

enum UserRole {
  USER
  PREMIUM
  ADMIN
}

enum UserPlan {
  FREE
  PAY_AS_YOU_GO
  PREMIUM
  STARTER
  PRO
}

enum CreditTransactionType {
  PURCHASE
  USAGE
  REFUND
  BONUS
  SUBSCRIPTION
  PROMOTION
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  EXPIRED
  TRIALING
}

enum ProviderTier {
  FREE
  PRO
}

enum GeneratedAssetType {
  IMAGE
  VIDEO
}

enum NotificationType {
  CREDIT_LOW
  CREDIT_ADDED
  IMAGE_READY
  TOOL_NEW
  SUBSCRIPTION_EXPIRING
  SYSTEM
  ASSET_LIKE
  SESSION_REMINDER
}

enum MarketingEventType {
  CREDIT_THRESHOLD_75
  CREDIT_THRESHOLD_50
  CREDIT_THRESHOLD_25
  CREDIT_THRESHOLD_10
  CREDIT_THRESHOLD_5
  CREDIT_DEPLETED
  CREDIT_EXHAUSTED
  FIRST_GENERATION
  UPGRADE_PROMPT
  REENGAGEMENT
}

enum CreditEmailStatus {
  PENDING
  SENT
  FAILED
}

enum ContentSampleSource {
  MANUAL
  CHAT
  TWEET
  POST
  IMPORT
}

enum SocialProvider {
  X_TWITTER
  YOUTUBE
  TWITCH
  INSTAGRAM
  TIKTOK
}

enum SocialAccountStatus {
  ACTIVE
  EXPIRED
  REVOKED
  ERROR
}

enum TweetDraftStatus {
  DRAFT
  PREVIEW
  PUBLISHED
  FAILED
  CANCELLED
}

enum ScriptStatus {
  GENERATING
  COMPLETED
  FAILED
}

model GeneratedScript {
  id              String       @id @default(cuid())
  userId          String
  title           String?
  topic           String
  content         String       @db.Text
  platform        String
  tone            String?
  hookType        String?
  targetDuration  Int?
  estimatedDuration Int?
  wordCount       Int?
  thumbnailPrompt String?      @db.Text
  model           String?
  metadata        Json?
  status          ScriptStatus @default(COMPLETED)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
}

// ============================================================
// COMMUNITY BOT - Auto-replies to the creator's community
// channels (Telegram, WhatsApp, Instagram) using the creator's
// style profile + AI models. One config per creator, one
// channel per type per creator (v1).
// ============================================================

model CommunityBotConfig {
  id                    String   @id @default(cuid())
  userId                String   @unique
  isEnabled             Boolean  @default(false)
  modelId               String   @default("google/gemini-2.5-flash")
  temperature           Float    @default(0.7)
  maxTokens             Int      @default(500)
  systemPromptExtra     String?  @db.Text
  useStyleProfile       Boolean  @default(true)
  historyLength         Int      @default(10)
  dailyReplyLimit       Int      @default(200)
  perContactCooldownSec Int      @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunityChannel {
  id               String                 @id @default(cuid())
  userId           String
  type             CommunityChannelType
  status           CommunityChannelStatus @default(DISCONNECTED)
  credentials      String?                @db.Text // AES-256-GCM encrypted JSON
  externalIdentity String? // e.g. @bot_username / phone number
  lastConnectedAt  DateTime?
  lastError        String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts      CommunityContact[]
  conversations CommunityConversation[]

  @@unique([userId, type])
  @@index([userId])
  @@index([status])
}

model CommunityContact {
  id          String    @id @default(cuid())
  channelId   String
  externalId  String // telegram user id / whatsapp jid
  username    String?
  displayName String?
  isBlocked   Boolean   @default(false)
  lastReplyAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  channel       CommunityChannel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversations CommunityConversation[]

  @@unique([channelId, externalId])
  @@index([channelId])
}

model CommunityConversation {
  id            String    @id @default(cuid())
  channelId     String
  contactId     String
  messageCount  Int       @default(0)
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  channel  CommunityChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contact  CommunityContact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages CommunityMessage[]

  @@unique([channelId, contactId])
  @@index([channelId, lastMessageAt])
}

model CommunityMessage {
  id                String                 @id @default(cuid())
  conversationId    String
  direction         CommunityMessageDirection
  externalMessageId String? // channel-native id, used for dedup
  content           String                 @db.Text
  status            CommunityMessageStatus @default(RECEIVED)
  modelId           String?
  tokensUsed        Int?
  creditsUsed       Int?
  skipReason        String? // cooldown | daily_limit | insufficient_credits | blocked_contact | bot_disabled
  createdAt         DateTime               @default(now())

  conversation CommunityConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

enum CommunityChannelType {
  TELEGRAM
  WHATSAPP
  INSTAGRAM
}

enum CommunityChannelStatus {
  DISCONNECTED
  CONNECTING
  AWAITING_QR
  ACTIVE
  REQUIRES_RESCAN
  ERROR
}

enum CommunityMessageDirection {
  INBOUND
  OUTBOUND
}

enum CommunityMessageStatus {
  RECEIVED
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

// ============================================================
// CONTENT PLANNER - Calendar of video production sessions.
// A ContentProject is one video (publish date + platform); its
// ContentEvents are the time blocks scheduled to produce it
// (ideation, scripting, recording, editing...). Events may also
// exist on their own (e.g. a livestream or a meeting).
// ============================================================

enum ContentEventType {
  IDEATION
  SCRIPTING
  RECORDING
  EDITING
  THUMBNAIL
  PUBLISHING
  LIVESTREAM
  OTHER
}

enum ContentEventStatus {
  PLANNED
  IN_PROGRESS
  DONE
  CANCELLED
}

model ContentProject {
  id               String    @id @default(cuid())
  userId           String
  title            String
  /// "youtube-long" | "youtube-short" | "tiktok" | "reels" | "twitch" | "other"
  platform         String?
  /// User-defined platform; when set, `platform` is null.
  customPlatformId String?
  publishAt        DateTime?
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  customPlatform ContentCustomPlatform? @relation(fields: [customPlatformId], references: [id], onDelete: SetNull)
  events         ContentEvent[]

  @@index([userId, publishAt])
  @@index([customPlatformId])
}

model ContentEvent {
  id              String             @id @default(cuid())
  userId          String
  projectId       String?
  /// User-defined type; when set, `type` is OTHER.
  customTypeId    String?
  title           String
  type            ContentEventType   @default(OTHER)
  status          ContentEventStatus @default(PLANNED)
  startAt         DateTime
  endAt           DateTime
  notes           String?            @db.Text
  /// Minutes before `startAt` to notify the user; null = no reminder.
  reminderMinutes Int?               @default(15)
  /// `startAt - reminderMinutes`, kept in sync on every write (indexed for the reminder poller).
  remindAt        DateTime?
  /// Set when the reminder was sent; reset when the session is rescheduled.
  reminderSentAt  DateTime?
  /// Platform tool suggested for this session, e.g.
  /// { toolId: "thumbnail-generator", intention: "...", prompt: "..." }.
  toolAction      Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    ContentProject?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customType ContentCustomType? @relation(fields: [customTypeId], references: [id], onDelete: SetNull)

  @@index([userId, startAt])
  @@index([projectId])
  @@index([customTypeId])
  @@index([remindAt])
}

/// Session types created by the user (e.g. "Podcast", "Sponsor call").
/// Deleting one keeps its sessions, which fall back to OTHER.
model ContentCustomType {
  id        String   @id @default(cuid())
  userId    String
  name      String
  /// Palette key, e.g. "teal" (see PALETTE_COLORS).
  color     String
  /// Icon key, e.g. "mic" (see PALETTE_ICONS).
  icon      String   @default("tag")
  createdAt DateTime @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  events ContentEvent[]

  @@unique([userId, name])
}

/// Platforms created by the user for their video projects (e.g. "Kick").
model ContentCustomPlatform {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects ContentProject[]

  @@unique([userId, name])
}

/// The user's production-step template for "Plan a video", in order.
/// Saved when a plan is created; without rows the built-in steps are used.
model ContentProductionStep {
  id              String            @id @default(cuid())
  userId          String
  position        Int
  /// Built-in type the step comes from; null for steps the user added.
  baseType        ContentEventType?
  /// Overrides; null = the built-in type's (translated) name, color, icon.
  name            String?
  color           String?
  icon            String?
  durationMinutes Int
  enabled         Boolean           @default(true)
  /// Scheduled at the publish date/time instead of on a day before it.
  isPublish       Boolean           @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
}

enum ContentAiPlanStatus {
  ANALYZED
  APPLIED
}

/// One run of the AI planning assistant: the model's structured plan,
/// what it cost and, once added to the calendar, the project it created.
model ContentAiPlan {
  id             String              @id @default(cuid())
  userId         String
  /// Text model used (ModelMetadata.modelId).
  modelId        String
  status         ContentAiPlanStatus @default(ANALYZED)
  title          String
  complexity     String
  /// Normalised plan (steps, tool actions, estimates, RAG evidence).
  result         Json
  /// What the user gave: idea length, file names, whether voice was used.
  inputSummary   Json?
  creditsCharged Int
  projectId      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Vector RAG index of the planner: embedded summaries of the user's past
/// productions (sourceType "project"), retrieved by cosine similarity to
/// calibrate new plans. Vectors of different embedding models are never
/// compared: `embeddingModel` is part of every lookup.
model ContentKnowledgeChunk {
  id             String   @id @default(cuid())
  userId         String
  sourceType     String
  sourceId       String
  content        String   @db.Text
  /// Hash of `content`, to re-embed only what changed.
  contentHash    String
  embedding      Float[]  @db.Real
  embeddingModel String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId, embeddingModel], name: "chunkSource", map: "ContentKnowledgeChunk_source_key")
  @@index([userId, embeddingModel])
}

// ============================================================
// VIDEO CLIPPER - AI video analysis (the video never leaves the browser)
// ============================================================

/// One run of the AI Video Analyzer & Smart Clipper. Only the structured
/// result is stored: the video and its keyframes stay on the user's device.
model VideoAnalysis {
  id             String   @id @default(cuid())
  userId         String
  /// Vision model used (ModelMetadata.modelId).
  modelId        String
  /// Name of the local file (shown in history; the file is not uploaded).
  fileName       String
  durationSec    Float
  /// Keyframes sent to the model (drives the price).
  frameCount     Int
  /// Normalised analysis: highlights (timestamped clips), hooks, titles…
  result         Json
  creditsCharged Int
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─── Robotina — AI voice assistant (tool "voice-assistant", §14g) ─────────
// Only text is stored: the audio (Deepgram TTS) is streamed to the
// browser and never saved.

model VoiceConversation {
  id        String         @id @default(cuid())
  userId    String
  /// The first message, shortened.
  title     String
  /// Language of the last exchange ("en" | "es" | "pt"): Robotina answers
  /// — and speaks, with the matching TTS voice — in it.
  language  String         @default("en")
  /// Text model of the last reply (ModelMetadata.modelId).
  modelId   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  VoiceMessage[]
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model VoiceMessage {
  id             String            @id @default(cuid())
  conversationId String
  /// "user" | "assistant"
  role           String
  content        String
  language       String            @default("en")
  /// User: said with the voice (STT). Assistant: answered with the voice.
  spoken         Boolean           @default(false)
  /// Assistant: TTS voice model that spoke the reply.
  voice          String?
  /// Assistant: milliseconds of speech (drives the price of spoken replies).
  audioMs        Int               @default(0)
  creditsCharged Int               @default(0)
  /// Assistant: the user cut the reply short.
  interrupted    Boolean           @default(false)
  /// Assistant: actions she ran during the reply (AssistantActionRecord[]),
  /// e.g. a session created in the Content Planner.
  actions        Json?
  modelId        String?
  createdAt      DateTime          @default(now())
  conversation   VoiceConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─── Voice settings (Admin → Voice: STT & TTS) ────────────────────────────
// One row ("global"): the Deepgram models, voices and prices of the
// platform's voice. Read through @creator-hub/voice-settings (cached);
// while the row doesn't exist the defaults of voice-settings.types.ts apply.

model VoiceSettings {
  id                  String   @id @default("global")
  /// Deepgram speech-to-text model ("nova-3", "nova-2"…).
  sttModel            String   @default("nova-3")
  /// Credits per minute of voice input, prorated by the started second.
  sttCreditsPerMinute Float    @default(60)
  /// Credits per minute of synthesized speech (Robotina's spoken replies).
  ttsCreditsPerMinute Float    @default(120)
  /// Voice per language: { en|es|pt: { model: "aura-2" | "flux", voice: "…" } }.
  ttsVoices           Json
  /// Free plan minutes with Robotina (her voice + the user's); null = no limit.
  freeTierMinutes     Int?
  /// "monthly" (back on the 1st, UTC) or "lifetime" (once).
  freeTierPeriod      String   @default("monthly")
  /// Admin who saved it last.
  updatedById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Seconds of voice with Robotina (the user's voice + hers) used by a Free
/// plan user, per UTC month ("2026-11") and in total ("all") — checked
/// against VoiceSettings.freeTierMinutes.
model VoiceUsage {
  id        String   @id @default(cuid())
  userId    String
  period    String
  seconds   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
}
