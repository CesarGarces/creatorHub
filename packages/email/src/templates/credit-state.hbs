<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin:0; padding:0; background:#0a0a0f; font-family:system-ui,-apple-system,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="padding:32px 12px;">
    <tr>
      <td align="center">
        <!-- Fluid up to 480px so the email also fits narrow screens (phones, previews) -->
        <table width="100%" cellpadding="0" cellspacing="0" style="max-width:480px; background:#14141f; border-radius:16px; border:1px solid rgba(255,255,255,0.06); padding:40px 28px;">
          <!-- Header -->
          <tr>
            <td align="center" style="padding-bottom:24px;">
              {{#if depleted}}
              <div style="width:56px; height:56px; background:linear-gradient(135deg, #ff4444, #ff6b6b); border-radius:14px; margin:0 auto; line-height:56px; text-align:center;">
                <span style="font-size:28px; color:#ffffff;">!</span>
              </div>
              {{else}}
              <div style="width:56px; height:56px; background:linear-gradient(135deg, #f5a524, #ffc857); border-radius:14px; margin:0 auto; line-height:56px; text-align:center;">
                <span style="font-size:28px; color:#ffffff;">!</span>
              </div>
              {{/if}}
            </td>
          </tr>
          <tr>
            <td align="center" style="padding-bottom:24px;">
              <h1 style="color:#f0f0f5; font-size:24px; margin:0;">{{heading}}</h1>
            </td>
          </tr>

          <!-- Balance Card -->
          <tr>
            <td style="padding-bottom:24px;">
              <table width="100%" cellpadding="0" cellspacing="0" style="background:#1a1a2e; border-radius:12px; padding:24px; border:1px solid {{#if depleted}}rgba(255,68,68,0.15){{else}}rgba(245,165,36,0.15){{/if}};">
                <tr>
                  <td align="center" style="padding-bottom:12px;">
                    <span style="color:#8888a0; font-size:12px; text-transform:uppercase; letter-spacing:1px;">Credits remaining</span>
                  </td>
                </tr>
                <tr>
                  <td align="center">
                    <span style="color:{{#if depleted}}#ff6b6b{{else}}#f5a524{{/if}}; font-size:40px; font-weight:700;">{{credits}}</span>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Body -->
          {{#each paragraphs}}
          <tr>
            <td style="padding-bottom:16px;">
              <p style="color:#c0c0d0; font-size:14px; line-height:1.6; margin:0;">{{#each this}}{{this}}{{#unless @last}}<br>{{/unless}}{{/each}}</p>
            </td>
          </tr>
          {{/each}}

          <!-- CTA Button -->
          {{#if ctaUrl}}
          <tr>
            <td align="center" style="padding:8px 0 24px 0;">
              <a href="{{ctaUrl}}" style="background:#00bbd9; color:#ffffff; font-size:15px; font-weight:600; text-decoration:none; padding:14px 36px; border-radius:8px; display:inline-block;">{{ctaLabel}}</a>
            </td>
          </tr>
          {{/if}}

          <!-- Footer -->
          <tr>
            <td align="center" style="border-top:1px solid rgba(255,255,255,0.06); padding-top:24px;">
              <p style="color:#444460; font-size:11px; margin:0;">You are receiving this email because of your credit balance on Creator Hub.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
